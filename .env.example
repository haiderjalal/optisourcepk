# ------------------------------------------------------------------
# OptiSource PK — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ------------------------------------------------------------------

# Canonical origin. Used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://optisourcepk.com

# ---- Inquiry notifications (Resend) ------------------------------
# Without RESEND_API_KEY and INQUIRY_FROM_EMAIL the inquiry endpoint still
# accepts and logs submissions — it just cannot email them. Set both before
# launch.
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
INQUIRY_FROM_EMAIL=faisal@optisourcepk.com
# Where trade inquiries land. Defaults to CONTACT.email in src/lib/site.ts.
INQUIRY_NOTIFICATION_EMAIL=info@optisourcepk.com

# --- Back office (/shop) -----------------------------------------------
# Supabase project that holds customers, stock, invoices and the ledger.
# Project Settings -> API. The anon/publishable key is safe in the browser;
# RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://dxdzxqkaedkaxxpviven.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR4ZHp4cWthZWRrYXh4cHZpdmVuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk3ODc0MzIsImV4cCI6MjEwNTM2MzQzMn0.uPkjnVqU-g5ipGnHR2vECzVG6I1-ziF9NqrnynOpXrw

# ---- WhatsApp Cloud API webhook ---------------------------------------
# A string you invent; paste the same value into the "Verify token" field in
# App Dashboard -> WhatsApp -> Configuration.
WHATSAPP_VERIFY_TOKEN=
# App Dashboard -> App settings -> Basic -> App secret. Used to verify that a
# POST really came from Meta. Server-side only, never NEXT_PUBLIC_.
WHATSAPP_APP_SECRET=
