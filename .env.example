# ------------------------------------------------------------------
# OptiSource PK — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ------------------------------------------------------------------

# Canonical origin. Used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://optisource.pk

# ---- Inquiry notifications (Resend) ------------------------------
# Without RESEND_API_KEY and INQUIRY_FROM_EMAIL the inquiry endpoint still
# accepts and logs submissions — it just cannot email them. Set both before
# launch.
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
INQUIRY_FROM_EMAIL=inquiries@optisource.pk
# Where trade inquiries land. Defaults to CONTACT.email in src/lib/site.ts.
INQUIRY_NOTIFICATION_EMAIL=sales@optisource.pk
